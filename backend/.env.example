# Nach dem Kopieren in ".env" mit echten Werten befüllen.
# cp .env.example .env

# --- Allgemein ---
ENVIRONMENT=development

# --- Datenbank ---
# Lokale Entwicklung (SQLite):
DATABASE_URL=sqlite:///./app.db
# Produktion (PostgreSQL), Beispiel:
# DATABASE_URL=postgresql://user:password@localhost:5432/application_manager

# --- OpenAI / LLM ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# --- SMTP / Mailversand ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-email@example.com

# --- Arbeitsagentur API ---
ARBEITSAGENTUR_CLIENT_ID=your-client-id
ARBEITSAGENTUR_CLIENT_SECRET=your-client-secret

# --- Generierte Dateien (Bewerbungs-PDFs) ---
GENERATED_FILES_DIR=generated/applications
