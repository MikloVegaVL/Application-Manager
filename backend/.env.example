# Nach dem Kopieren in ".env" mit echten Werten befüllen.
# cp .env.example .env

# --- Allgemein ---
ENVIRONMENT=development

# --- Datenbank ---
# Lokale Entwicklung (SQLite):
DATABASE_URL=sqlite:///./app.db
# Produktion (PostgreSQL), Beispiel:
# DATABASE_URL=postgresql://user:password@localhost:5432/application_manager

# --- Ollama / LLM ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Kleineres, schnelleres Modell nur für die CV-Analyse (siehe
# app/core/config.py: OLLAMA_MODEL_CV_PARSING).
OLLAMA_MODEL_CV_PARSING=qwen2.5:3b-instruct
# Muss zu app/core/config.py's OLLAMA_TIMEOUT_SECONDS-Default passen (dort
# ausführlich begründet) - sonst überschreibt ein aus dieser Vorlage
# kopiertes .env den sichereren Default stillschweigend mit einem zu
# niedrigen Wert (siehe frontend/nginx.conf, ce-debug-Untersuchung,
# 2026-08-28: genau diese Drift zwischen config.py und nginx.conf).
OLLAMA_TIMEOUT_SECONDS=600.0

# --- SMTP / Mailversand ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-email@example.com

# --- Arbeitsagentur API ---
ARBEITSAGENTUR_CLIENT_ID=your-client-id
ARBEITSAGENTUR_CLIENT_SECRET=your-client-secret

# --- Jobsuche: LinkedIn / Xing (anonym, keine Zugangsdaten nötig) ---
# JOB_SEARCH_LINKEDIN_ENABLED=true
# JOB_SEARCH_XING_ENABLED=true
# JOB_SEARCH_DEADLINE_SECONDS=12.0
# JOB_SEARCH_LINKEDIN_RESULT_CAP=10
# JOB_SEARCH_LINKEDIN_COOLDOWN_SECONDS=300.0

# --- Jobsuche: weitere HTML-Boards (anonym, keine Zugangsdaten nötig) ---
# JOB_SEARCH_DEVJOBS_ENABLED=true
# JOB_SEARCH_KIMETA_ENABLED=true
# JOB_SEARCH_STEPSTONE_ENABLED=true
# JOB_SEARCH_GERMANTECHJOBS_ENABLED=true
# JOB_SEARCH_INDEED_ENABLED=true
# JOB_SEARCH_JOBWARE_ENABLED=true
# JOB_SEARCH_PROGRAMMIERERJOBBOERSE_ENABLED=true
# JOB_SEARCH_IT_ENTWICKLER_JOBS_ENABLED=true

# --- Jobsuche: credential-basierte APIs (Deutschland) ---
# Ohne diese Werte erscheinen Adzuna/Jooble als "not-configured" statt als Fehler.
# JOB_SEARCH_ADZUNA_ENABLED=true
# JOB_SEARCH_JOOBLE_ENABLED=true
# ADZUNA_APP_ID=your-adzuna-app-id
# ADZUNA_APP_KEY=your-adzuna-app-key
# JOOBLE_API_KEY=your-jooble-api-key

# --- Generierte Dateien (Bewerbungs-PDFs) ---
GENERATED_FILES_DIR=generated/applications
